# ──────────────────────────────────────────────────────────────
# DeepThink 环境变量参考模板
# 复制为 .env 并按需修改。运行时优先级：环境变量 > Web UI 设置 > 默认值。
# 本地源码部署用 `make start` 即可，多数变量有默认值，无需全部填写。
# ──────────────────────────────────────────────────────────────

# ─── 运行时核心 ───────────────────────────────────────────────
# Web 服务监听端口（默认 9898）
WEB_PORT=9898
# 数据根目录：数据库/配置/工作区/记忆/技能/MCP 全部在此。
# 默认 ~/.deepthink/data。桌面版自动注入其 userData 目录，无需手动设。
# DEEPTHINK_DATA_DIR=/home/me/.deepthink/data
# 时区
TZ=Asia/Shanghai
# 环境标识
NODE_ENV=production
# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# ─── Web / 代理 ───────────────────────────────────────────────
# 反向代理（nginx/ingress）后部署时设 true，让后端信任 X-Forwarded-* 头
TRUST_PROXY=false
# 单文件上传上限（MB）
MAX_FILE_SIZE_MB=50

# ─── 会话与凭据 ───────────────────────────────────────────────
# Cookie/会话签名密钥（64 位 hex）。不设则首启随机生成并持久化。
# 多副本部署（K8s/PM2 多实例）必须显式设置，否则各 Pod 会话不互通。
# 生成：openssl rand -hex 32
# WEB_SESSION_SECRET=

# Claude API key。留空则走 Web Setup 向导录入（AES-256-GCM 加密落盘）。
# ANTHROPIC_API_KEY=sk-ant-xxx

# ─── 桌面版路径覆盖（仅开发调试用，打包模式自动解析）──────────
# DEEPTHINK_BACKEND_DIR=
# DEEPTHINK_WEB_DIST_DIR=
# DEEPTHINK_AGENT_RUNNER_DIR=
# DEEPTHINK_NODE_BINARY=

# ─── 多副本模式（K8s / 多 Pod）─────────────────────────────────
# 设 DATABASE_URL 启用 PostgreSQL 后端（不设则用 SQLite，仅单副本）。
# DATABASE_URL=postgresql://deepthink:password@postgres:5432/deepthink
# 设 REDIS_URL 启用跨 Pod 事件总线 + 分布式选主 + Agent IPC。
# 不设时所有 Redis 能力 no-op 降级，单进程零开销。
# REDIS_URL=redis://redis:6379

# ─── IM 渠道集成（可选）──────────────────────────────────────
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
