{
  "name": "deepthink",
  "version": "1.0.0",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "reset:admin": "tsx src/reset-admin.ts",
    "admin:cli": "tsx src/admin-account-cli.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest",
    "dev:all": "npx concurrently --timestamp-format \"yyyy-MM-dd HH:mm:ss.SSS\" -n backend,frontend -c blue,green \"npm run dev\" \"npm run dev:web\"",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm run build",
    "build:all": "npx concurrently --group -n backend,web,agent-runner \"npm run build\" \"npm run build:web\" \"npm --prefix container/agent-runner run build\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "*",
    "@hono/node-server": "^1.19.9",
    "@larksuiteoapi/node-sdk": "^1.58.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@whiskeysockets/baileys": "^6.17.16",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.5.0",
    "dingtalk-stream": "2.1.6-beta.1",
    "discord.js": "^14.26.2",
    "grammy": "^1.40.0",
    "hono": "^4.11.9",
    "mammoth": "^1.12.0",
    "node-pty": "^1.1.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright-core": "^1.61.1",
    "proxy-agent": "^6.5.0",
    "qrcode": "^1.5.4",
    "sqlite-vec": "^0.1.9",
    "undici": "6.24.1",
    "ws": "^8.19.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIGeniusInstitute/deepthink.git"
  },
  "homepage": "https://github.com/AIGeniusInstitute/deepthink#readme",
  "bugs": {
    "url": "https://github.com/AIGeniusInstitute/deepthink/issues"
  },
  "author": "aigeniusinstitute",
  "keywords": [
    "claude",
    "claude-code",
    "ai-agent",
    "self-hosted",
    "feishu",
    "lark",
    "telegram",
    "chatbot",
    "docker",
    "mcp"
  ],
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "node-pty@1.1.0": true,
    "protobufjs@7.6.5": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
